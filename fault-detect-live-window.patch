+.slot-critical .slot-flag { color: #7a3f3f; }
+.timer-corner { position: fixed; right: 16px; bottom: 16px; z-index: 45; display: grid; gap: 8px; width: min(340px, 92vw); }
+.timer-item { display: flex; align-items: center; gap: 12px; border-left: 6px solid var(--gold); padding: 10px 12px; }
+.timer-count { font-size: 32px; font-weight: 700; min-width: 44px; text-align: center; color: var(--text-head); font-variant-numeric: tabular-nums; }
+.timer-text { display: grid; flex: 1; font-size: 13px; }
+.timer-text span { color: var(--text-muted); }
+.timer-started { border-left-color: var(--teal); }
