@@ -0,0 +1,18 @@
+// The faults that matter to the person acting: pop-ups (not acknowledged yet) and the bell list (acknowledged, not resolved).
+import { useCallback, useEffect, useState } from 'react'
+import { get, live } from './api.js'
+
+export function useFaults(username) {
+  const [state, setState] = useState({ popups: [], bell: [], storage_alerts: 0 })
+  const reload = useCallback(() => {
+    if (!username) return
+    get(`/api/faults?user=${username}`).then((d) => d.popups && setState(d)).catch(() => {})
+  }, [username])
+  useEffect(() => {
+    reload()
+    live.on('faults_changed', reload)
+    live.on('connect', reload)
+    return () => { live.off('faults_changed', reload); live.off('connect', reload) }
+  }, [reload])
+  return { ...state, reload }
+}
diff --git a/system/frontend/src/useLive.js b/system/frontend/src/useLive.js
new file mode 100644
index 0000000..3cdcc89
--- /dev/null
+++ b/system/frontend/src/useLive.js
@@ -0,0 +1,59 @@
+// Keeps the Overview in step with the server. Readings arrive straight from the live connection (stream 1),
+// statuses the moment a window closes (stream 2), and a full snapshot each second carries the marks.
+import { useEffect, useState } from 'react'
+import { get, live } from './api.js'
+import { worst } from './status.js'
+
+function patchReading(data, r) {
+  return {
+    ...data,
+    machines: data.machines.map((m) => {
+      const p = m.parameters[r.parameter]
+      if (m.id !== r.machine_id || !p) return m
+      const value = typeof r.value === 'number' ? r.value : null
+      return { ...m, parameters: { ...m.parameters, [r.parameter]: { ...p, value, invalid: !r.valid, sensor_fault: false } } }
+    }),
+  }
+}
+
+function patchStatus(data, w) {
+  return {
+    ...data,
+    machines: data.machines.map((m) => {
+      const p = m.parameters[w.parameter]
+      if (m.id !== w.machine_id || !p) return m
+      const parameters = { ...m.parameters, [w.parameter]: { ...p, status: w.status } }
+      return { ...m, parameters, status: worst(parameters) }
+    }),
+  }
+}
+
+export function useOverview() {
+  const [data, setData] = useState(null)
+  const [connected, setConnected] = useState(live.connected)
+
+  useEffect(() => {
+    let alive = true
+    get('/api/overview').then((d) => alive && setData(d)).catch(() => {})
+    const onOverview = (d) => setData(d)
+    const onReading = (r) => setData((d) => (d ? patchReading(d, r) : d))
+    const onStatus = (w) => setData((d) => (d ? patchStatus(d, w) : d))
+    const onConnect = () => setConnected(true)
+    const onDisconnect = () => setConnected(false)
+    live.on('overview', onOverview)
+    live.on('reading', onReading)
+    live.on('status', onStatus)
+    live.on('connect', onConnect)
+    live.on('disconnect', onDisconnect)
+    return () => {
+      alive = false
+      live.off('overview', onOverview)
+      live.off('reading', onReading)
+      live.off('status', onStatus)
+      live.off('connect', onConnect)
+      live.off('disconnect', onDisconnect)
+    }
+  }, [])
+
+  return { data, connected }
+}
diff --git a/system/frontend/src/user.jsx b/system/frontend/src/user.jsx
new file mode 100644
index 0000000..f22c67e
--- /dev/null
+++ b/system/frontend/src/user.jsx
@@ -0,0 +1,61 @@
+// Who is signed in. FR-26 (sign out after the person's own idle time), FR-28 (sign in first).
+import { createContext, useCallback, useContext, useEffect, useState } from 'react'
+import { get, post, live, getToken, setToken } from './api.js'
+
+const UserContext = createContext({ user: null, ready: false })
+
+export function UserProvider({ children }) {
+  const [user, setUser] = useState(null)
+  const [ready, setReady] = useState(false)
+
+  const clear = useCallback((note) => {
+    setToken('')
+    live.disconnect()
+    if (note) sessionStorage.setItem('fd-note', note)
+    setUser(null)
+  }, [])
+
+  useEffect(() => {
+    if (!getToken()) { setReady(true); return }
+    get('/api/me').then((d) => { if (d.username) setUser(d) }).finally(() => setReady(true))
+  }, [])
+
+  useEffect(() => {
+    const onUnauth = () => clear('Your sign-in ended. Please sign in again.')
+    window.addEventListener('fd-unauth', onUnauth)
+    return () => window.removeEventListener('fd-unauth', onUnauth)
+  }, [clear])
+
+  useEffect(() => { if (user) live.connect(); else live.disconnect() }, [user])
+
+  // FR-26: signed out after this person's idle time. Only the person's own activity keeps the session alive.
+  useEffect(() => {
+    if (!user) return undefined
+    let last = Date.now()
+    let pinged = Date.now()
+    const mark = () => { last = Date.now() }
+    const events = ['mousemove', 'keydown', 'click', 'touchstart', 'scroll']
+    events.forEach((e) => window.addEventListener(e, mark))
+    const timer = setInterval(() => {
+      if (Date.now() - last > user.session_min * 60000) {
+        post('/api/signout')
+        clear(`You were signed out after ${user.session_min} minute${user.session_min > 1 ? 's' : ''} without activity.`)
+      } else if (last > pinged && Date.now() - pinged > 20000) {
+        pinged = Date.now()
+        post('/api/me/ping')
+      }
+    }, 5000)
+    return () => { events.forEach((e) => window.removeEventListener(e, mark)); clearInterval(timer) }
+  }, [user, clear])
+
+  const signIn = async (username, password) => {
+    const r = await post('/api/signin', { username, password })
+    if (r.ok) { setToken(r.token); setUser(r.user) }
+    return r
+  }
+  const signOut = async () => { await post('/api/signout'); clear() }
+
+  return <UserContext.Provider value={{ user, ready, signIn, signOut, setUser }}>{children}</UserContext.Provider>
+}
+
+export const useUser = () => useContext(UserContext)
