+
+export default function Layout({ faults, overview, machineType, children }) {
+  const data = overview
+  return (
+    <div className="shell">
+      <SideNav />
+      <div className="main">
+        <TopBar bell={faults.bell} storageAlerts={faults.storage_alerts} machines={data?.machines ?? []} mode={data?.mode} link={data?.link} />
