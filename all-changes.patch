diff --git a/system/backend/model.py b/system/backend/model.py
index 99ccb70..59b57e9 100644
--- a/system/backend/model.py
+++ b/system/backend/model.py
@@ -49,6 +49,35 @@ def limit_in_force(machine_type, parameter, level, value=None):
     return r.get("abnormal_below")
 
 
+def fluctuation(machine_type, parameter, values):
+    """FR-4 / SRS A.4 'fluctuating'. The typical step from one reading to the next, as a share of the mean (median of the 9 steps).
+    A swing steps by a lot every second; one spike, one ramp or plain noise leave the median step small, so FR-6 still holds."""
+    if rule_for(machine_type, parameter).get("fluctuation_step") is None or len(values) < 4:
+        return None
+    mean = sum(values) / len(values)
+    if mean == 0:
+        return None
+    steps = sorted(abs(b - a) for a, b in zip(values, values[1:]))
+    n = len(steps)
+    med = steps[n // 2] if n % 2 else (steps[n // 2 - 1] + steps[n // 2]) / 2
+    return med / abs(mean)
+
+
+def is_fluctuating(machine_type, parameter, values):
+    cv = fluctuation(machine_type, parameter, values)
+    return cv is not None and cv > rule_for(machine_type, parameter)["fluctuation_step"]
+
+
+def observed_value(machine_type, parameter, values):
+    """The reading furthest past the limit, for the pop-up ('138 C now')."""
+    if not values:
+        return None
+    r = rule_for(machine_type, parameter)
+    if r.get("abnormal_below") is not None and min(values) < r["abnormal_below"] and not any(v > (r.get("abnormal") or r.get("warning") or float("inf")) for v in values):
+        return min(values)
+    return max(values)
+
+
 def trend_check(levels, fraction=None):
     """levels = the screening level of each clean reading in the 10-second window.
     The window gets the highest level that at least `fraction` of its readings reach. One reading alone never does. FR-6."""
@@ -94,6 +123,8 @@ def classify(machine_type, parameter, window_values):
     allowed = levels_for(machine_type, parameter)
     levels = [threshold_level(machine_type, parameter, v) for v in window_values]
     rule_level = trend_check(levels)
+    if rule_level == "normal" and is_fluctuating(machine_type, parameter, window_values) and "abnormal" in allowed:
+        return "abnormal"                      # a steady spread over the whole window counts, one wild reading does not (std needs all 10)
     if rule_level == "normal":
         return "normal"
     clf = _CLF if _CLF_TRIED else _train()
diff --git a/system/backend/seed.py b/system/backend/seed.py
index 802e4b4..9814fa9 100644
--- a/system/backend/seed.py
+++ b/system/backend/seed.py
@@ -90,6 +90,54 @@ def _band(machine_type, parameter, truth, rng):
     return rng.uniform(r["abnormal_below"] * 0.7, r["abnormal_below"] * 0.97)
 
 
+def _clip_near(limit, side, rng, lo, hi, sd):
+    """One reading near a limit with noise. side = 'under' keeps it on the safe side, 'over' keeps it beyond."""
+    v = limit * rng.uniform(lo, hi) + rng.gauss(0, abs(limit) * sd)
+    return min(v, limit * 0.998) if side == "under" else max(v, limit * 1.005)
+
+
+def noisy_windows(rng, per_case=30):
+    """Windows close to a limit, with noise. Labels come from how each window is BUILT (NFR-1, NFR-2).
+    near_normal: every reading stays under the limit.  near_fault: every reading is over it by 1 to 6 percent.
+    brief: two to four readings over, the rest under (FR-6: never a fault).  swing: pump speed that swings (SRS A.4)."""
+    out = []
+    for mt, params in config.LIMITS.items():
+        for p, r in params.items():
+            top = r.get("warning") if r.get("warning") is not None else r.get("abnormal")
+            levels = [("warning", r["warning"]), ("critical", r["critical"])] if r.get("critical") is not None else \
+                     ([("abnormal", r["abnormal"])] if r.get("abnormal") is not None else [])
+            for _ in range(per_case):
+                if top is not None:                                                 # upper limit
+                    out.append({"machine_type": mt, "parameter": p, "truth": "normal", "kind": "near_normal",
+                                "values": [_clip_near(top, "under", rng, 0.93, 0.99, 0.015) for _ in range(config.WINDOW_S)]})
+                    k = rng.randrange(2, 5)
+                    vals = [_clip_near(top, "under", rng, 0.93, 0.99, 0.015) for _ in range(config.WINDOW_S)]
+                    for i in rng.sample(range(config.WINDOW_S), k):
+                        vals[i] = top * rng.uniform(1.02, 1.10)
+                    if r.get("critical") is None or True:
+                        vals = [min(v, r["critical"] * 0.97) if r.get("critical") is not None else v for v in vals]
+                    out.append({"machine_type": mt, "parameter": p, "truth": "normal", "kind": "brief", "values": vals})
+                    for name, lim in levels:
+                        hi = 1.06
+                        if name == "warning":
