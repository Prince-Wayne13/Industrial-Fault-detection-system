+/* ---- older pages brought into the new look (Machines, Machine, Settings, Admin, Demo, Tracker, Sign in) ---- */
+.page > h1 { font-size: 30px; margin-bottom: 6px; }
+.page > h2, .page h2 { font-size: 20px; margin: 26px 0 12px; }
+.page > .muted:first-of-type { margin: 0 0 18px; }
+/* the old status badge now looks like the pill: a dot and an upper-case word */
+.badge { display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px; border: 0; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; color: var(--text-head); white-space: nowrap; }
+.badge::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--secondary); flex: none; }
+.badge.normal { background: rgba(107, 142, 123, 0.22); color: var(--text-head); } .badge.normal::before { background: var(--teal); }
+.badge.warning, .badge.abnormal { background: rgba(184, 160, 106, 0.22); color: var(--text-head); } .badge.warning::before, .badge.abnormal::before { background: var(--warning); }
+.badge.critical { background: rgba(160, 107, 107, 0.2); color: var(--text-head); } .badge.critical::before { background: var(--red); }
+.badge.unknown { background: var(--secondary-dim); color: var(--text-head); }
+/* buttons */
+.demo-btn { min-height: 44px; padding: 0 18px; border-radius: var(--radius-sm); font-weight: 600; font-size: 15px; background: var(--primary); color: var(--bg-card); border: 1px solid transparent; }
+.demo-btn:hover { background: #38495f; }
+.demo-btn-off { background: transparent; color: var(--primary); border: 1px solid var(--border-light); font-weight: 400; }
+.demo-btn-off:hover { background: var(--primary-dim); }
+.demo-btn:disabled { opacity: 0.5; cursor: not-allowed; }
+.linkbtn { min-height: 44px; display: inline-flex; align-items: center; }
+/* forms */
+select, input:not([type]), input[type="text"], input[type="password"], input[type="number"] { min-height: 40px; padding: 0 10px; border-radius: var(--radius-sm); border: 1px solid var(--border-light); background: #fff; }
+.demo-row label, .signin-card label, .demo-card label { font-size: 14px; color: var(--text-body); }
+.demo-row { gap: 12px; }
+.demo-card { padding: 18px 20px; }
+/* tables */
+.fault-table { font-size: 14px; }
+.fault-table th { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-body); font-weight: 700; padding: 12px 14px; border-top: 0; border-bottom: 1px solid var(--border-light); }
+.fault-table td { padding: 12px 14px; border-top: 1px solid var(--border-faint); }
+.fault-table tbody tr:hover { background: var(--primary-dim); }
+.fault-table a { color: var(--primary); font-weight: 600; }
+.table-wrap { padding: 4px 6px; }
+/* marks beside readings and in tables */
+.mark { padding: 3px 10px; border-radius: 999px; border: 0; font-size: 11px; letter-spacing: 0.06em; color: var(--text-head); }
+.mark-fault, .mark-overdue { background: rgba(160, 107, 107, 0.24); }
+.mark-invalid { background: rgba(184, 160, 106, 0.28); }
+.mark-maint { background: rgba(123, 107, 142, 0.2); }
+/* machine page tiles */
+.page .tiles:not(.summary-tiles) { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
+/* sign in: no shell, centred paper card */
+.signin { max-width: 440px; margin: 0 auto; padding: 72px 16px 0; }
+.signin h1 { text-align: center; color: var(--primary); margin-bottom: 14px; }
+.signin-card { padding: 24px; box-shadow: var(--shadow-pop); }
+.slot { border-radius: var(--radius-sm); }
+.bar { border-radius: 999px; }
